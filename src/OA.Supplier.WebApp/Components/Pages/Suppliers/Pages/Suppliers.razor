@page "/suppliers"

@using Microsoft.AspNetCore.Authorization
@using OA.Supplier.Application.Suppliers
@using OA.Supplier.Domain.Suppliers

@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject ISupplierRepository SupplierRepository
@inject DeleteSupplier.ICommandHandler DeleteSupplierCommandHandler

@attribute [Authorize]

<PageTitle>Supplier</PageTitle>

<div class="d-flex gap-3">   
    <h1>Supplier</h1>
    <button class="btn btn-outline-primary" @onclick="AddItem">
        Add
    </button>
</div>

@if (_suppliers is null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th></th>
            <th aria-label="Supplier Name">Name</th>
            <th aria-label="Supplier Address">Address</th>
        </tr>
        </thead>
        <tbody>
        @foreach (SupplierViewModel supplier in _suppliers)
        {
            <tr>
                <td>
                    <div class="d-flex gap-3">   
                        <button class="btn btn-primary" @onclick="() => EditItem(supplier.Id)">
                            Edit
                        </button>
                        <button class="btn btn-danger" @onclick="() => DeleteItem(supplier.Id)">
                            Delete
                        </button>
                    </div>
                </td>
                <td>@supplier.Name</td>
                <td>@supplier.Address</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private SupplierViewModel[]? _suppliers;

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();
    }

    private async Task LoadSuppliers()
    {
        IEnumerable<Supplier> suppliers = await SupplierRepository.GetAllAsync();
        IEnumerable<SupplierViewModel> suppliersViewModel = suppliers.Select(SupplierViewModel.MapFrom);
        _suppliers = suppliersViewModel.ToArray();
    }

    private void AddItem()
    {
        NavigationManager.NavigateTo("/suppliers/create");
    }
    
    private void EditItem(int id)
    {
        NavigationManager.NavigateTo($"/suppliers/{id}/edit");
    }

    private async Task DeleteItem(int id)
    {
        bool result = await DeleteSupplierCommandHandler.HandleAsync(new DeleteSupplier.DeleteSupplierRequest(id));
        
        if (result)
            await LoadSuppliers();
    }
    
    private record SupplierViewModel(int Id, string Name, string Address)
    {
        public static SupplierViewModel MapFrom(Supplier supplier) => 
            new(supplier.Id, supplier.Name, supplier.Address);
    }
}