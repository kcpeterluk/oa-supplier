@page "/suppliers/{Id:int}/edit"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OA.Supplier.Application.SupplierRates
@using OA.Supplier.Application.Suppliers
@using OA.Supplier.Domain.SupplierRates
@using OA.Supplier.Domain.Suppliers

@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject GetSupplierQueryHandler.IQueryHandler GetSupplierQueryHandler
@inject GetSupplierRatesQueryHandler.IQueryHandler GetSupplierRatesQueryHandler
@inject CreateSupplierRate.ICommandHandler CreateSupplierRateCommandHandler
@inject UpdateSupplier.ICommandHandler UpdateSupplierCommandHandler

@attribute [Authorize]

<PageTitle>Supplier</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1>Supplier</h1>
    <button class="btn btn-outline-secondary" @onclick="NavigateBack" aria-label="Close">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

<EditForm Model="_supplierEditorViewModel" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="_supplierEditorViewModel.Name" />
        <ValidationMessage For="@(() => _supplierEditorViewModel.Name)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        <InputText class="form-control" @bind-Value="_supplierEditorViewModel.Address" />
        <ValidationMessage For="@(() => _supplierEditorViewModel.Address)" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

<hr/>

<div class="d-flex gap-3">
    <h3 class="mb-0">Rates</h3>
    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenRatePanel" aria-label="Add supplier rate">
        <i class="bi bi-plus-lg"></i>
    </button>
</div>

@if (_supplierRates is null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th aria-label="Supplier Rate">Rate</th>
            <th aria-label="Supplier Rate Start Date">Start Date</th>
            <th aria-label="Supplier Rate End Date">End Date</th>
        </tr>
        </thead>
        <tbody>
        @if (_supplierRates.Length == 0)
        {
            <tr>
                <td colspan="3">No supplier rates found.</td>
            </tr>
        }
        else
        {
            @foreach (SupplierRateViewModel supplierRate in _supplierRates)
            {
                <tr>
                    <td>@supplierRate.Rate</td>
                    <td>@supplierRate.RateStartDate</td>
                    <td>@supplierRate.RateEndDate?.ToString()</td>
                </tr>
            }
        }
        </tbody>
    </table>
}

@if (_isRatePanelOpen)
{
    <div class="offcanvas-backdrop fade show" @onclick="CloseRatePanel"></div>
    <aside class="offcanvas offcanvas-end show"
           tabindex="-1"
           style="visibility: visible;"
           role="dialog"
           aria-modal="true"
           aria-labelledby="add-rate-title">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="add-rate-title">Add Rate</h5>
            <button type="button" class="btn-close" @onclick="CloseRatePanel" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <EditForm Model="_supplierRateEditorViewModel" OnValidSubmit="HandleCreateSupplierRate">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Rate</label>
                    <InputNumber class="form-control" @bind-Value="_supplierRateEditorViewModel.Rate" />
                    <ValidationMessage For="@(() => _supplierRateEditorViewModel.Rate)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Rate Start Date</label>
                    <InputDate class="form-control" @bind-Value="_supplierRateEditorViewModel.RateStartDate" />
                    <ValidationMessage For="@(() => _supplierRateEditorViewModel.RateStartDate)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Rate End Date</label>
                    <InputDate class="form-control" @bind-Value="_supplierRateEditorViewModel.RateEndDate" />
                    <ValidationMessage For="@(() => _supplierRateEditorViewModel.RateEndDate)" />
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseRatePanel">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </EditForm>
        </div>
    </aside>
}

@code {
    [Parameter]
    public int Id { get; set; }
    
    private SupplierEditorViewModel _supplierEditorViewModel = new()
    {
        Name = string.Empty,
        Address = string.Empty
    };

    private SupplierRateEditorViewModel _supplierRateEditorViewModel = CreateDefaultSupplierRateEditorViewModel(0);
    private SupplierRateViewModel[]? _supplierRates;
    private bool _isRatePanelOpen;
    private string _userName = string.Empty;
    
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _userName = user.Identity?.Name ?? string.Empty;
        
        SupplierDto? supplier = await GetSupplierQueryHandler.HandleAsync(Id);
        if (supplier is not null)
        {
            _supplierEditorViewModel = new SupplierEditorViewModel
            {
                Name = supplier.Name,
                Address = supplier.Address
            };
        }

        await RefreshSupplierRates();
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/suppliers");
    }

    private async Task HandleSubmit()
    {
        bool result = await UpdateSupplierCommandHandler.HandleAsync(new UpdateSupplierRequest(
            Id: Id,
            Name: _supplierEditorViewModel.Name,
            Address: _supplierEditorViewModel.Address
        ));
        
        if (result)
            NavigateBack();
    }

    private void OpenRatePanel()
    {
        _supplierRateEditorViewModel = CreateDefaultSupplierRateEditorViewModel(Id);
        _isRatePanelOpen = true;
    }

    private void CloseRatePanel()
    {
        _isRatePanelOpen = false;
    }

    private async Task HandleCreateSupplierRate()
    {
        await CreateSupplierRateCommandHandler.HandleAsync(new CreateSupplierRateRequest(
            SupplierId: _supplierRateEditorViewModel.SupplierId,
            Rate: _supplierRateEditorViewModel.Rate,
            RateStartDate: _supplierRateEditorViewModel.RateStartDate,
            RateEndDate: _supplierRateEditorViewModel.RateEndDate,
            CreatedByUser: _userName
        ));

        await RefreshSupplierRates();
        _supplierRateEditorViewModel = CreateDefaultSupplierRateEditorViewModel(Id);
        CloseRatePanel();
    }

    private async Task RefreshSupplierRates()
    {
        IEnumerable<SupplierRateDto> supplierRates = await GetSupplierRatesQueryHandler.HandleAsync(Id);
        _supplierRates = supplierRates.Select(SupplierRateViewModel.MapFrom).ToArray();
    }

    private static SupplierRateEditorViewModel CreateDefaultSupplierRateEditorViewModel(int supplierId)
    {
        DateOnly today = DateOnly.FromDateTime(DateTime.Today);
        return new SupplierRateEditorViewModel
        {
            SupplierId = supplierId,
            Rate = 0,
            RateStartDate = today
        };
    }

    private record SupplierRateViewModel(decimal Rate, DateOnly RateStartDate, DateOnly? RateEndDate)
    {
        public static SupplierRateViewModel MapFrom(SupplierRateDto supplierRate) => 
            new(supplierRate.Rate, supplierRate.RateStartDate, supplierRate.RateEndDate);
    }

    private class SupplierRateEditorViewModel : IValidatableObject
    {
        [Range(1, int.MaxValue, ErrorMessage = "SupplierId must be greater than 0.")]
        public int SupplierId { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Rate must be a positive value.")]
        public decimal Rate { get; set; }

        public DateOnly RateStartDate { get; set; }

        public DateOnly? RateEndDate { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (RateEndDate.HasValue && RateStartDate > RateEndDate.Value)
            {
                yield return new ValidationResult(
                    "Rate start date must be before or equal to rate end date.",
                    new[] { nameof(RateEndDate) });
            }
        }
    }
}
