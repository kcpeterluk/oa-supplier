@page "/suppliers/create"

@using Microsoft.AspNetCore.Authorization
@using OA.Supplier.Application.Suppliers
@using OA.Supplier.Domain.Suppliers

@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject CreateSupplier.ICommandHandler CreateSupplierCommandHandler

@attribute [Authorize]

<PageTitle>Supplier</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1>Supplier</h1>
    <button class="btn btn-outline-secondary" @onclick="NavigateBack" aria-label="Close">
        <i class="bi bi-x-lg"></i>
    </button>
</div>

<EditForm Model="_supplierEditorViewModel" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="_supplierEditorViewModel.Name" />
        <ValidationMessage For="@(() => _supplierEditorViewModel.Name)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        <InputText class="form-control" @bind-Value="_supplierEditorViewModel.Address" />
        <ValidationMessage For="@(() => _supplierEditorViewModel.Address)" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</EditForm>

@code {
    private SupplierEditorViewModel _supplierEditorViewModel = new()
    {
        Name = string.Empty,
        Address = string.Empty
    };
    
    private string _userName = string.Empty;
    
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _userName = user.Identity?.Name ?? string.Empty;
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/suppliers");
    }

    private async Task HandleSubmit()
    {
        SupplierDto supplier = await CreateSupplierCommandHandler.HandleAsync(new CreateSupplierRequest(
            Name: _supplierEditorViewModel.Name,
            Address: _supplierEditorViewModel.Address,
            CreatedByUser: _userName
        ));
        NavigationManager.NavigateTo($"/suppliers/{supplier.Id}/edit");
    }
}