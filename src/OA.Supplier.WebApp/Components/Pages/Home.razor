@page "/"
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Infrastructure
@using Microsoft.EntityFrameworkCore.Storage
@using OA.Supplier.Infrastructure.Persistence
@using OA.Supplier.WebApp.Infrastructure.Persistence
@rendermode InteractiveServer
@inject SupplierDbContext SupplierDbContext
@inject ApplicationIdentityDbContext ApplicationIdentityDbContext

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<div class="d-flex gap-3">
    <button class="btn btn-primary" @onclick="InitialiseDatabase">Initialise Database</button>
    <button class="btn btn-danger" @onclick="DropDatabase">Drop Database</button>
</div>

<p>@_databaseActionStatus</p>

@code {
    private string _databaseActionStatus = "";
    
    private async Task InitialiseDatabase()
    {
        _databaseActionStatus = "Initialising database...";
        
        await SupplierDbContext.Database.EnsureDeletedAsync();
        await SupplierDbContext.Database.EnsureCreatedAsync();
        
        IRelationalDatabaseCreator applicationIdentityDbCreator = ApplicationIdentityDbContext.Database.GetService<IRelationalDatabaseCreator>();
        await applicationIdentityDbCreator.CreateTablesAsync();
        
        _databaseActionStatus = "Database initialised successfully.";
    }
    
    private async Task DropDatabase()
    {
        _databaseActionStatus = "Dropping database...";
        
        await SupplierDbContext.Database.EnsureDeletedAsync();
        
        _databaseActionStatus = "Database dropped successfully.";
    }
}