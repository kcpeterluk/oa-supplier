@page "/"
@using OA.Supplier.Infrastructure
@rendermode InteractiveServer
@inject SupplierDbContext DbContext

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<div class="d-flex gap-3">
    <button class="btn btn-primary" @onclick="InitialiseDatabase">Initialise Database</button>
    <button class="btn btn-danger" @onclick="DropDatabase">Drop Database</button>
</div>

<p>@_databaseActionStatus</p>

@code {
    private string _databaseActionStatus = "";
    
    private async Task InitialiseDatabase()
    {
        await DbContext.Database.EnsureDeletedAsync();
        await DbContext.Database.EnsureCreatedAsync();
        _databaseActionStatus = "Database initialised successfully.";
    }
    
    private async Task DropDatabase()
    {
        await DbContext.Database.EnsureDeletedAsync();
        _databaseActionStatus = "Database dropped successfully.";
    }
}